{
  "manifest_version": 3,
  "name": "GESTALT Browser Desk",
  "version": "0.1.0",
  "homepage_url": "https://github.com/numbpill3d/gestalt",
  "description": "A retro local bookmark desk for saving, organizing, importing, and exporting browser links.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open GESTALT", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": ["tabs", "storage", "contextMenus"]
}
